{
  "name": "mochila-contexto",
  "version": "0.3.0",
  "description": "Mochila de contexto para Windows, basada en Edge-Drop",
  "author": "Proyecto Mochila; base original Deepender25 / Edge-Drop",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:github": "npm run build && electron-builder --win dir --publish never",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.mochila.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:mochila": "npm run build && electron-builder --win dir --publish never",
    "test:mochila": "vitest run tests/mochila",
    "typecheck:upstream-web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "build": {
    "appId": "local.mochila.contexto",
    "productName": "Mochila",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/mochila*",
      "LICENSE",
      "NOTICE",
      "README.md",
      "package.json"
    ],
    "extraResources": [],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*",
      "**/node_modules/@resvg/**/*"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/mochila.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mochila",
      "artifactName": "Mochila-Setup-0.3.0.exe"
    },
    "portable": {
      "artifactName": "Mochila-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@iconify-json/cuida": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-separator": "^1.1.11",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.1.0",
    "emoji-datasource-twitter": "^16.0.0",
    "framer-motion": "^11.0.24",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "react-dom": "^18.2.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "react": "^18.2.0",
    "zustand": "^4.5.2"
  }
}
